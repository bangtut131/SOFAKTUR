generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SoSession {
  id               String   @id @default(uuid())
  periodName       String   // e.g. "Week 4 Jan 2026"
  status           String   @default("OPEN") // OPEN, WAITING_APPROVAL, FINALIZED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Stats
  totalItems       Int      @default(0)
  totalValue       Float    @default(0)
  
  // Relations
  items            SoItem[]

  @@index([createdAt])
  @@index([status])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Plain text for simplicity per request, or hashed? Assuming simple first.
  role      String   // ADMIN, FINANCE, STAFF
  createdAt DateTime @default(now())
}

model RoleConfig {
  id              String   @id @default(uuid())
  role            String   @unique // ADMIN, FINANCE, STAFF
  visibleColumns  String   @default("[]") // JSON string of visible column keys
  canEditColumns  String   @default("[]") // JSON string of editable column keys
}

model SoItem {
  id               String   @id @default(uuid())
  sessionId        String
  session          SoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  // Snapshot of Invoice Data
  transNo          String
  transDate        String
  dueDate          String?
  customerName     String
  description      String?
  statusName       String?
  approvalStatus   String?
  amount           Float
  outstanding      Float
  primeOwing       Float
  
  // SO Process Fields
  scannedAt        DateTime?
  status           String   @default("UNVERIFIED") // UNVERIFIED, MATCHED
  existenceStatus  String?  // Ada, Hilang, Dibawa Sales
  remarks          String?  // Keterangan Tambahan
  notes            String?  // Validation notes (optional, keep for flexibility)
  
  @@index([sessionId])
  @@index([transNo])
  @@index([sessionId, transNo]) // Composite index for scan lookup
  @@index([sessionId, customerName]) // For sorting by customer
  @@index([sessionId, transDate]) // For sorting by date
  @@index([sessionId, status]) // For filtering by status
}

model Customer {
  id            String   @id @default(uuid())
  accurateId    String   @unique // ID from Accurate
  name          String
  contactPerson String?
  phone         String?  // Main WA number
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receivables   Receivable[]
}

model Receivable {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  transNo         String
  transDate       DateTime
  dueDate         DateTime
  amount          Float
  outstanding     Float
  branchId        String?
  
  status          String   @default("OPEN") // OPEN, PAID
  lastSyncedAt    DateTime @default(now())
  
  @@unique([transNo]) // Assume Invoice No is unique
  @@index([customerId])
}

model BroadcastSchedule {
  id              String   @id @default(uuid())
  name            String   @unique // e.g. "Weekly Sync", "Friday Broadcast"
  cronExpression  String   // e.g. "0 9 * * 1"
  isEnabled       Boolean  @default(false)
  type            String   // SYNC, BROADCAST
  messageTemplate String?  // Only for BROADCAST
  lastRun         DateTime?
  nextRun         DateTime?
  status          String   @default("IDLE") // IDLE, RUNNING
  
  // Optional Filters
  minDaysSinceTrans Int?   // Minimum days since invoice transaction date
  minDaysOverdue    Int?   // Minimum days past due date
  
  // SO Sync Specific
  branchId          String?
  startDate         DateTime?
  endDate           DateTime?
  invoiceStatus     String?   @default("UNPAID") // UNPAID, PAID, ALL
}

model BroadcastLog {
  id              String   @id @default(uuid())
  customerId      String
  customerName    String
  phone           String
  message         String
  sentAt          DateTime @default(now())
  status          String   // PENDING, SENT, FAILED
  error           String?
  source          String   @default("SYSTEM") // SYSTEM, MANUAL
}

model SystemSetting {
  key             String   @id
  value           String
  description     String?
}

model FakturAbsensi {
  id          String   @id @default(uuid())
  date        DateTime // Tanggal absensi
  salesName   String   // Nama sales
  notes       String?
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       FakturAbsensiItem[]

  @@index([date])
  @@index([salesName])
}

model FakturAbsensiItem {
  id            String   @id @default(uuid())
  absensiId     String
  absensi       FakturAbsensi @relation(fields: [absensiId], references: [id], onDelete: Cascade)

  transNo       String   // Nomor faktur
  customerName  String
  amount        Float    @default(0)

  handedAt      DateTime @default(now())
  returnedAt    DateTime?
  returnStatus  String   @default("OUT") // OUT, RETURNED
  remarks       String?

  @@index([absensiId])
  @@index([transNo])
  @@index([returnStatus])
}
