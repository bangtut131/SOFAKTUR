FROM node:20-alpine

# Install system dependencies needed for Prisma and native modules
RUN apk add --no-cache libc6-compat openssl python3 make g++

WORKDIR /app

# Install dependencies first (cached layer)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source code
COPY . .

# Accept build-time environment variables from Coolify
ARG DATABASE_URL
ARG DIRECT_URL
ARG NEXTAUTH_SECRET
ARG NEXTAUTH_URL
ARG ACCURATE_API_TOKEN
ARG ACCURATE_APP_KEY
ARG ACCURATE_APP_SECRET
ARG ACCURATE_CLIENT_ID
ARG ACCURATE_CLIENT_SECRET
ARG ACCURATE_DB_ID
ARG ACCURATE_API_HOST

ENV DATABASE_URL=$DATABASE_URL
ENV DIRECT_URL=$DIRECT_URL
ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV ACCURATE_API_TOKEN=$ACCURATE_API_TOKEN
ENV ACCURATE_APP_KEY=$ACCURATE_APP_KEY
ENV ACCURATE_APP_SECRET=$ACCURATE_APP_SECRET
ENV ACCURATE_CLIENT_ID=$ACCURATE_CLIENT_ID
ENV ACCURATE_CLIENT_SECRET=$ACCURATE_CLIENT_SECRET
ENV ACCURATE_DB_ID=$ACCURATE_DB_ID
ENV ACCURATE_API_HOST=$ACCURATE_API_HOST
ENV NODE_ENV=production

# Build: only generate Prisma client + build Next.js (no DB changes during build)
RUN npx prisma generate && next build

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["npm", "start"]
